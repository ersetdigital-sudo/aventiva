# Salin file ini jadi .env.local lalu isi nilainya.
# Nilai Supabase: Dashboard Supabase → Project Settings → API.
# Di Vercel: isi keempat variabel di bawah ini lewat Settings → Environment
# Variables (Production + Preview). Lihat catatan urutan di paling bawah.

# --- Boleh terlihat di browser (dipakai storefront & halaman publik) ---
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sbp_isi_dengan_kunci_publishable

# --- Rahasia server: JANGAN pernah diberi awalan NEXT_PUBLIC_ ---

# Kata sandi login /admin. Mengganti nilainya otomatis membatalkan sesi lama.
ADMIN_KEY=ganti-dengan-rahasia-acak

# Kunci rahasia server Supabase (sb_secret_…) dari project yang SAMA dengan URL
# di atas. Dipakai HANYA untuk menulis dari panel admin: tambah/edit/hapus
# produk, ubah status transaksi, upload gambar QRIS.
# Kosong atau salah = panel admin tetap bisa MEMBACA, tapi simpan akan gagal.
SUPABASE_SECRET_KEY=

# Catatan urutan deploy:
# - NEXT_PUBLIC_* dibaca saat BUILD. Isi dulu, baru deploy; kalau nilainya
#   diubah, deploy ulang supaya ikut terpasang.
# - ADMIN_KEY & SUPABASE_SECRET_KEY dibaca saat RUNTIME di server, jadi
#   mengubahnya tidak butuh deploy ulang.

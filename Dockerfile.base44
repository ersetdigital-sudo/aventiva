# Development image for the Base44 sandbox.
# Only manifests are copied here so dependencies live in the image, while the
# application source stays bind-mounted from the sandbox (edits are instant).
# Never bake the source in: `docker-compose.base44.yml` mounts the repo at /app.
FROM node:22-bookworm-slim

ENV NODE_ENV=development \
    NEXT_TELEMETRY_DISABLED=1

WORKDIR /app

COPY package.json package-lock.json ./

RUN npm ci --no-audit --no-fund

EXPOSE 3000
